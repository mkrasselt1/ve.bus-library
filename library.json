{
  "name": "VEBus",
  "version": "1.2.0",
  "description": "ESP32 Arduino library for Victron Multiplus VE.Bus RS485 communication. Supports ESS power setpoint (with optional battery-neutral virtual setpoint mode), sleep/wake commands, battery/AC data readback, and ESPHome integration. Example firmware adds Home Assistant MQTT discovery, a web dashboard, OTA updates and NUT/apcupsd network UPS servers.",
  "keywords": ["victron", "ve.bus", "multiplus", "ess", "inverter", "charger", "rs485", "esp32", "home-assistant", "mqtt", "ups", "nut", "apcupsd"],
  "authors": [
    {
      "name": "Michael Krasselt",
      "url": "https://github.com/mkrasselt1"
    },
    {
      "name": "PepeTheFroggie",
      "url": "https://github.com/PepeTheFroggie/Victron-VE.Bus---esp32"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mkrasselt1/ve.bus-library.git"
  },
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "build": {
    "srcDir": "src"
  },
  "examples": [
    {
      "name": "Basic ESS",
      "base": "examples/basic_ess",
      "files": ["main.cpp"]
    },
    {
      "name": "MQTT Home Assistant",
      "base": "examples/mqtt_ha",
      "files": ["main.cpp", "web_ui.h", "nut_server.h", "apcupsd_server.h"]
    }
  ]
}
